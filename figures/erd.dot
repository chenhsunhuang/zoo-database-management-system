digraph G {
graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="1.0", fontname="DejaVu Sans", labelloc=t, label="Zoo database | Physical foreign-key relationships", fontsize=22];
node [shape=plain,fontname="DejaVu Sans"];
edge [color="#65758b", arrowsize=0.65];
animal [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#9aabbd"><TR><TD COLSPAN="2" BGCOLOR="#e4f2eb"><B>animal</B></TD></TR><TR><TD PORT="a_id" ALIGN="LEFT">a_id</TD><TD ALIGN="LEFT"><FONT COLOR="#52637c" POINT-SIZE="10">PK </FONT></TD></TR><TR><TD ALIGN="LEFT">species</TD><TD PORT="species" ALIGN="LEFT"><FONT COLOR="#52637c" POINT-SIZE="10">FK</FONT></TD></TR><TR><TD PORT="sex" ALIGN="LEFT">sex</TD><TD ALIGN="LEFT"><FONT COLOR="#52637c" POINT-SIZE="10">&nbsp;</FONT></TD></TR><TR><TD PORT="life_status" ALIGN="LEFT">life_status</TD><TD ALIGN="LEFT"><FONT COLOR="#52637c" POINT-SIZE="10">&nbsp;</FONT></TD></TR><TR><TD PORT="a_name" ALIGN="LEFT">a_name</TD><TD ALIGN="LEFT"><FONT COLOR="#52637c" POINT-SIZE="10">&nbsp;</FONT></TD></TR></TABLE>>];
